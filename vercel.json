{
  "functions": {
    "api/slide.js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/bot.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/video.js": {
      "memory": 2048,
      "maxDuration": 300,
      "includeFiles": "node_modules/ffmpeg-static/ffmpeg"
    }
  },
  "crons": [
    {
      "path": "/api/bot?a=cron",
      "schedule": "30 23 * * *"
    }
  ]
}
